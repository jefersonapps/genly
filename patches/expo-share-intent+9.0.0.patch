+    val id = value.getStringExtra(REQUEST_ID) ?: UUID.randomUUID().toString().also { value.putExtra(REQUEST_ID, it) }
+    if (pending.none { it.getStringExtra(REQUEST_ID) == id }) pending.addLast(value)

+  @Synchronized fun cached(id: String): Map<String, Any?>? = payloads[id]
+  @Synchronized fun cache(id: String, value: Map<String, Any?>) {
+    if (pending.any { it.getStringExtra(REQUEST_ID) == id }) payloads[id] = value
+  }
+  @Synchronized fun acknowledge(id: String): Boolean {
+    val first = pending.peekFirst() ?: return false
+    val firstId = first.getStringExtra(REQUEST_ID) ?: return false
+    if (id.isNotEmpty() && id != firstId) return false
+    pending.removeFirst()
+    payloads.remove(firstId)
+    return true
+  }
+}

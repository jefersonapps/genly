<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="16dp"
  android:background="@drawable/genly_group_preview_background">
  <TextView android:id="@+id/genly_group_widget_name"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Meu grupo" android:textSize="16sp" android:textStyle="bold"
    android:maxLines="1" android:ellipsize="end"
    android:textColor="@color/genly_group_preview_text" />
  <TextView android:layout_width="match_parent" android:layout_height="0dp"
    android:layout_weight="1" android:gravity="center" android:padding="12dp"
    android:text="As notas do grupo aparecem aqui" android:textSize="14sp"
    android:textColor="@color/genly_group_preview_secondary" />
</LinearLayout>
